# Where the Agent Builder API runs. Required for `npm run dev` and `npm run preview` (the /api proxy target).
AGENT_BUILDER_URL=http://localhost:8100
# Bearer key the proxy adds to every request. Stays on the server; never sent to the browser.
AGENT_BUILDER_API_KEY=
# Fallback X-User when the browser sends none (requests made before sign-in).
AGENT_BUILDER_USER=

# Banking gateway (services/banking-gateway). Optional; without it the banking screens say the gateway is not set up.
# Where it runs, e.g. the mock: `npm --prefix services/banking-gateway run start:mock` prints its address and token.
BANKING_GATEWAY_URL=
# The gateway's runtime token (GATEWAY_TOKEN). Added by the proxy to read-only routes only; never sent to the browser.
BANKING_GATEWAY_TOKEN=
# "on" lets Studio's Banking page start rehearsals on a MOCK gateway (its /dev/ routes) and run tools for them only.
BANKING_GATEWAY_REHEARSALS=
